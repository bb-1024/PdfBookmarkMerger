<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF側(net10.0-windows専用)を参照するため、このテストプロジェクトもwindows TFMにする。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- ByteArrayToImageConverter(Avalonia)がAvalonia.Media.Imaging.Bitmapを生成するには、
         プラットフォームレンダリング基盤の初期化(通常はアプリ起動時に行われる)が必要なため、
         テストではヘッドレスプラットフォームを使って初期化する。 -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PdfBookmarkMerger.App\PdfBookmarkMerger.App.csproj" />
    <ProjectReference Include="..\..\src\PdfBookmarkMerger.Wpf\PdfBookmarkMerger.Wpf.csproj" />
    <ProjectReference Include="..\..\src\PdfBookmarkMerger.Avalonia\PdfBookmarkMerger.Avalonia.csproj" />
  </ItemGroup>

</Project>
