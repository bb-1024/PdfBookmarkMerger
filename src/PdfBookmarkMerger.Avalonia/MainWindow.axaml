<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdfBookmarkMerger.App.ViewModels;assembly=PdfBookmarkMerger.App"
        xmlns:models="clr-namespace:PdfBookmarkMerger.Core.Models;assembly=PdfBookmarkMerger.Core"
        xmlns:conv="clr-namespace:PdfBookmarkMerger.AvaloniaApp.Converters"
        xmlns:dataConv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        xmlns:local="clr-namespace:PdfBookmarkMerger.AvaloniaApp"
        xmlns:resx="clr-namespace:PdfBookmarkMerger.App.Resources;assembly=PdfBookmarkMerger.App"
        x:Class="PdfBookmarkMerger.AvaloniaApp.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static resx:Strings.AppTitle}" Width="1300" Height="760"
        Icon="avares://PdfBookmarkMerger.Avalonia/Assets/app.ico"
        DragDrop.AllowDrop="True"
        DragDrop.Drop="OnWindowDrop"
        DragDrop.DragOver="OnWindowDragOver">
    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEqualsConverter" />
        <conv:NullableDoubleToStringConverter x:Key="NullableDoubleToStringConverter" />
        <conv:ZoomPercentToStringConverter x:Key="ZoomPercentToStringConverter" />
        <conv:DepthToTitleWidthConverter x:Key="DepthToTitleWidthConverter" />
        <conv:PageNumberWidthConverter x:Key="PageNumberWidthConverter" />
        <conv:EditedHighlightBrushConverter x:Key="EditedHighlightBrushConverter" />
        <conv:BusyProgressToTextConverter x:Key="BusyProgressToTextConverter" />
        <conv:PageCountToTextConverter x:Key="PageCountToTextConverter" />
        <conv:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter" />
        <conv:LinkGroupDisplayConverter x:Key="LinkGroupDisplayConverter" />
    </Window.Resources>

    <Grid RowDefinitions="*,Auto">
        <!-- 手順1: ファイル指定 -->
        <Grid Grid.Row="0" Margin="16" RowDefinitions="Auto,*,Auto"
              IsEnabled="{Binding !IsBusy.Value}"
              IsVisible="{Binding Step.Value, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=SelectFiles}">
            <TextBlock Grid.Row="0" Margin="0,0,0,8" FontSize="14" TextWrapping="Wrap"
                       Text="{x:Static resx:Strings.SelectFilesInstruction}" />

            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
              <Grid>
                <ListBox Name="FileListBox"
                         ItemsSource="{Binding FileList.Files}"
                         SelectionMode="Multiple"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         DragDrop.AllowDrop="True"
                         DragDrop.Drop="OnFileListDrop"
                         DragDrop.DragOver="OnFileListDragOver"
                         PointerMoved="OnFileListPointerMoved"
                         SelectionChanged="OnFileListSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:PdfFileEntryViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="4">
                                <StackPanel Orientation="Horizontal" Grid.Column="0" Spacing="8">
                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FilePath}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Text="{Binding PageCount.Value, Converter={StaticResource PageCountToTextConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{x:Static resx:Strings.DragDropPlaceholder}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" IsHitTestVisible="False" Foreground="Gray"
                           IsVisible="{Binding !FileList.HasFiles.Value}" />
              </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" Spacing="8">
                <Button Content="{x:Static resx:Strings.SettingsButton}" Command="{Binding OpenSettingsCommand}" Margin="0,0,16,0" />
                <Button Content="{x:Static resx:Strings.AddFilesButton}" Command="{Binding AddFilesViaDialogCommand}" />
                <Button Content="{x:Static resx:Strings.AddFolderButton}" Command="{Binding AddFolderViaDialogCommand}" />
                <Button Content="{x:Static resx:Strings.DeleteButton}" Click="OnRemoveSelectedFileClick" />
                <Button Name="MoveFileUpButton" Content="{x:Static resx:Strings.MoveUpButton}" Click="OnMoveFileUpClick" />
                <Button Name="MoveFileDownButton" Content="{x:Static resx:Strings.MoveDownButton}" Click="OnMoveFileDownClick" Margin="0,0,16,0" />
                <Button Content="{x:Static resx:Strings.NextButton}" Command="{Binding ConfirmFilesCommand}" />
            </StackPanel>
        </Grid>

        <!-- 手順2・3: しおり編集 -->
        <Grid Grid.Row="0" Margin="16" RowDefinitions="Auto,Auto,*,Auto"
              IsEnabled="{Binding !IsBusy.Value}"
              IsVisible="{Binding Step.Value, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=EditBookmarks}">
            <TextBlock Grid.Row="0" Margin="0,0,0,8" FontSize="14" TextWrapping="Wrap"><Run Text="{x:Static resx:Strings.EditBookmarksInstructionLine1}" /><LineBreak /><Run Text="{x:Static resx:Strings.EditBookmarksInstructionLine2}" /></TextBlock>

            <!-- ツリー開閉コントロール: 全ノードを閉じる/レベル指定で開閉/全ノードを開く -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                <Button Content="{x:Static resx:Strings.CollapseAllTreeButton}" Command="{Binding BookmarkTree.CollapseAllCommand}"
                        ToolTip.Tip="{x:Static resx:Strings.CollapseAllTreeButtonTooltip}" MinWidth="32" />
                <TextBlock Text="{x:Static resx:Strings.ExpandLevelLabel}" VerticalAlignment="Center" Margin="4,0" />
                <TextBox Name="ExpandLevelTextBox" Text="{Binding BookmarkTree.ExpandLevelInput.Value, Mode=TwoWay}"
                         ToolTip.Tip="{x:Static resx:Strings.ExpandLevelTextBoxTooltip}" Width="48"
                         LostFocus="OnExpandLevelTextBoxLostFocus" />
                <Button Content="{x:Static resx:Strings.ExpandAllTreeButton}" Command="{Binding BookmarkTree.ExpandAllCommand}"
                        ToolTip.Tip="{x:Static resx:Strings.ExpandAllTreeButtonTooltip}" MinWidth="32" />
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
              <Grid>
                <TreeView Name="BookmarkTreeView"
                          ItemsSource="{Binding BookmarkTree.RootNodes}"
                          Padding="0,0,0,32"
                          Background="Transparent"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          DragDrop.AllowDrop="True"
                          DragDrop.Drop="OnBookmarkTreeDrop"
                          DragDrop.DragOver="OnBookmarkTreeDragOver"
                          DragDrop.DragLeave="OnBookmarkTreeDragLeave"
                          PointerMoved="OnBookmarkTreePointerMoved"
                          SelectionChanged="OnBookmarkTreeSelectionChanged">
                    <TreeView.Styles>
                        <!--
                            TreeDataTemplateにはIsExpandedの指定手段が無いため、TreeViewItemへの
                            スタイルセッターで各ノードのIsExpanded(既定値true)を反映する。
                            これが無いと、全ノードが常にAvalonia既定の折りたたみ状態で表示されてしまう。
                        -->
                        <Style Selector="TreeViewItem" x:DataType="vm:BookmarkNodeViewModel">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded.Value, Mode=TwoWay}" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="vm:BookmarkNodeViewModel" ItemsSource="{Binding Children}">
                            <!-- Background明示: 未設定だとSpacingの隙間等がヒットテストされない。 -->
                            <StackPanel Orientation="Horizontal" Margin="2" Spacing="6" Tag="{Binding}"
                                        Background="Transparent">
                                <TextBlock Text="{Binding LevelNumber, StringFormat=Lv.{0}}"
                                           Width="34" VerticalAlignment="Center" Foreground="Gray" FontSize="11" />
                                <TextBox Text="{Binding Title.Value}" TextChanged="OnBookmarkTitleTextChanged">
                                    <TextBox.Width>
                                        <MultiBinding Converter="{StaticResource DepthToTitleWidthConverter}">
                                            <Binding Path="Depth" />
                                            <Binding Path="DataContext.BookmarkTree.TitleColumnBaseWidth.Value"
                                                     RelativeSource="{RelativeSource AncestorType=TreeView}"
                                                     x:CompileBindings="False" />
                                        </MultiBinding>
                                    </TextBox.Width>
                                </TextBox>
                                <ComboBox ItemsSource="{x:Static local:EnumSources.DestinationTypeValues}"
                                          SelectedItem="{Binding DestinationType.Value, Mode=TwoWay}"
                                          IsEnabled="{Binding IsDestinationTypeEditable.Value}" Width="90" />
                                <CheckBox Content="{x:Static resx:Strings.ExpandCheckboxLabel}" IsChecked="{Binding IsOpen.Value, Mode=TwoWay}"
                                          IsEnabled="{Binding IsExpandToggleEditable.Value}" VerticalAlignment="Center" Width="90" />
                                <TextBlock Text="{x:Static resx:Strings.LeftLabel}" VerticalAlignment="Center" FontSize="10" Foreground="Gray" />
                                <TextBox Text="{Binding Left.Value, Converter={StaticResource NullableDoubleToStringConverter}}"
                                         IsEnabled="{Binding IsLeftEditable.Value}" Width="48" />
                                <TextBlock Text="{x:Static resx:Strings.TopLabel}" VerticalAlignment="Center" FontSize="10" Foreground="Gray" />
                                <TextBox Text="{Binding Top.Value, Converter={StaticResource NullableDoubleToStringConverter}}"
                                         IsEnabled="{Binding IsTopEditable.Value}" Width="48" />
                                <TextBlock Text="{x:Static resx:Strings.ZoomLabel}" VerticalAlignment="Center" FontSize="10" Foreground="Gray" />
                                <TextBox Text="{Binding Zoom.Value, Converter={StaticResource ZoomPercentToStringConverter}}"
                                         IsEnabled="{Binding IsZoomEditable.Value}" Width="48" />
                                <TextBlock VerticalAlignment="Center" Foreground="Gray" FontSize="11">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{x:Static resx:Strings.BookmarkOriginPrefixFormat}">
                                            <Binding Path="SourceFileName" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBox Text="{Binding PreOffsetPageNumber.Value}"
                                         Width="{Binding PreOffsetPageNumber.Value, Converter={StaticResource PageNumberWidthConverter}}"
                                         Background="{Binding IsPageNumberEdited.Value, Converter={StaticResource EditedHighlightBrushConverter}}">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{x:Static resx:Strings.ResetPageNumberMenuItem}" Click="OnResetPreOffsetPageNumberClick" />
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                                <TextBlock Text="{x:Static resx:Strings.BookmarkOriginSuffix}" VerticalAlignment="Center" Foreground="Gray" FontSize="11" />
                                <TextBlock Text="{Binding DisplayMergedPageNumber.Value}" VerticalAlignment="Center" Foreground="Gray" FontSize="11" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!--
                    しおりD&amp;D中のドロップ位置インジケータ(挿入先を示す横線+丸)。TreeViewの上に重ねた
                    ヒットテスト無効なCanvasへ描画する(WPF版のBookmarkInsertionAdornerに相当)。
                    子/兄弟いずれとして挿入されるかを、対象行の上半分/下半分どちらにカーソルがあるかで
                    視覚的に区別する。
                -->
                <Canvas Name="BookmarkDropIndicatorCanvas" IsHitTestVisible="False">
                    <Line Name="BookmarkDropIndicatorLine" Stroke="DodgerBlue" StrokeThickness="2" IsVisible="False" />
                    <Ellipse Name="BookmarkDropIndicatorDot" Fill="DodgerBlue" Width="7" Height="7" IsVisible="False" />
                </Canvas>
              </Grid>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,12,0,0" Spacing="8">
                <!-- 1段目: レベル上下・しおり追加(3種)・削除・レベル上限設定 -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Name="PromoteLevelButton" Content="{x:Static resx:Strings.PromoteLevelButton}" Click="OnPromoteLevelClick" IsEnabled="False" />
                    <Button Name="DemoteLevelButton" Content="{x:Static resx:Strings.DemoteLevelButton}" Click="OnDemoteLevelClick" IsEnabled="False" Margin="0,0,16,0" />
                    <Button Content="{x:Static resx:Strings.AddRootButton}" Click="OnAddRootBookmarkClick" />
                    <Button Content="{x:Static resx:Strings.AddChildButton}" Click="OnAddChildBookmarkClick" />
                    <Button Content="{x:Static resx:Strings.AddSiblingButton}" Click="OnAddSiblingBookmarkClick" />
                    <Button Content="{x:Static resx:Strings.DeleteButton}" Click="OnDeleteBookmarkClick" Margin="0,0,16,0" />
                    <Button Name="LevelCapButton" Content="{x:Static resx:Strings.SetLevelCapButton}" Click="OnSetLevelCapClick"
                            IsEnabled="False" />
                </StackPanel>
                <!-- 2段目: 設定・画面遷移・元に戻す・一律設定(2種)・結合実行 -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static resx:Strings.SettingsButton}" Command="{Binding OpenSettingsCommand}" Margin="0,0,16,0" />
                    <Button Content="{x:Static resx:Strings.BackToFileListButton}" Command="{Binding BackToFileListCommand}" Margin="0,0,16,0" />
                    <Button Content="{x:Static resx:Strings.UndoButton}" Command="{Binding BookmarkTree.UndoCommand}" Margin="0,0,16,0" />
                    <CheckBox Content="{x:Static resx:Strings.ForceFitCheckbox}" IsChecked="{Binding BookmarkTree.ForceFitForAll.Value, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox Content="{x:Static resx:Strings.GlobalExpandCheckbox}" IsThreeState="True"
                              IsChecked="{Binding BookmarkTree.GlobalExpandOverride.Value, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="{x:Static resx:Strings.SaveBookmarkSettingsButton}" Command="{Binding SaveBookmarkSettingsCommand}" />
                    <Button Content="{x:Static resx:Strings.MergeButton}" Command="{Binding MergeCommand}" />
                    <Button Content="{x:Static resx:Strings.MergeAndEditLinksButton}" Command="{Binding MergeAndEditLinksCommand}"
                            IsVisible="{Binding ShowMergeAndEditLinksButton.Value}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 手順4: リンク編集 -->
        <Grid Grid.Row="0" Margin="16" RowDefinitions="Auto,Auto,*,Auto"
              IsEnabled="{Binding !IsBusy.Value}"
              IsVisible="{Binding Step.Value, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=EditLinks}">
            <TextBlock Grid.Row="0" Margin="0,0,0,8" FontSize="14" TextWrapping="Wrap"
                       Text="{x:Static resx:Strings.EditLinksInstructionLine1}" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="0" Margin="0,0,0,8">
                <Button Content="{x:Static resx:Strings.PreviousPageButton}" Command="{Binding LinkEditor.PreviousPageCommand}" Margin="0,0,4,0" />
                <TextBox Text="{Binding LinkEditor.PageNumberInput.Value}" Width="48" TextAlignment="Right"
                         VerticalContentAlignment="Center" Margin="0,0,4,0" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0"
                           Text="{Binding LinkEditor.PageCount.Value, StringFormat={x:Static resx:Strings.TotalPageCountFormat}}" />
                <Button Content="{x:Static resx:Strings.NextPageButton}" Command="{Binding LinkEditor.NextPageCommand}" Margin="0,0,24,0" />
                <Button Content="{x:Static resx:Strings.ZoomOutButton}" Command="{Binding LinkEditor.ZoomOutCommand}" Margin="0,0,8,0" />
                <Button Content="{x:Static resx:Strings.ZoomInButton}" Command="{Binding LinkEditor.ZoomInCommand}" />
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="*,220">
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                    <!-- 連続スクロールプレビュー: 全ページ分のプレースホルダ(LinkEditor.PageSlots)を
                         仮想化されたListBoxで縦に並べる。ビューポートに入ったページだけがLoadPageSlotAsyncで
                         描画され、外れたページはUnloadPageSlotで破棄されるため、数千ページ規模のPDFでも
                         全ページを同時に保持しない。選択・リンク作成・ホットスポット表示の対象は常に
                         現在ページ(IsCurrent)のみ。 -->
                    <ListBox Name="PdfPageListBox" ItemsSource="{Binding LinkEditor.PageSlots}"
                             Background="#11808080" BorderThickness="0" SelectionMode="Single" Focusable="False"
                             ScrollViewer.ScrollChanged="OnPdfPreviewScrollChanged">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:PdfPageSlotViewModel">
                                <Grid Loaded="OnPageSlotLoaded" Unloaded="OnPageSlotUnloaded">
                                    <Grid.Width>
                                        <Binding Path="DataContext.LinkEditor.PlaceholderWidth.Value"
                                                 RelativeSource="{RelativeSource AncestorType=ListBox}"
                                                 FallbackValue="0" x:CompileBindings="False" />
                                    </Grid.Width>
                                    <Grid.Height>
                                        <Binding Path="DataContext.LinkEditor.PlaceholderHeight.Value"
                                                 RelativeSource="{RelativeSource AncestorType=ListBox}"
                                                 FallbackValue="0" x:CompileBindings="False" />
                                    </Grid.Height>
                                    <Image Source="{Binding Image.Value, Converter={StaticResource ByteArrayToImageConverter}}"
                                           Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <!-- 現在ページのみ、選択・リンク作成のヒットレイヤーとホットスポットのオーバーレイを重ねる。 -->
                                    <Grid IsVisible="{Binding IsCurrent.Value}">
                                        <Rectangle Fill="Transparent"
                                                   PointerPressed="OnPdfPreviewPointerPressed"
                                                   PointerMoved="OnPdfPreviewPointerMoved"
                                                   PointerReleased="OnPdfPreviewPointerReleased" />
                                        <Canvas Name="LinkOverlayCanvas" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Grid.Column="1" RowDefinitions="*,*">
                    <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Row="0" Text="{x:Static resx:Strings.LinkEditorBookmarksHeader}" FontWeight="Bold" Margin="8" />

                            <!-- 文字選択が確定し、ジャンプ先の指定待ちの間だけ表示する。 -->
                            <StackPanel Grid.Row="1" Margin="8,0,8,8" Spacing="4"
                                        IsVisible="{Binding LinkEditor.PendingSelection.Value, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{x:Static resx:Strings.LinkDestinationPickerHeader}" FontWeight="Bold" />
                                <TextBlock Text="{x:Static resx:Strings.PickArbitraryTargetHint}" TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                           IsVisible="{Binding LinkEditor.IsPickingArbitraryTarget.Value}" />
                                <Button Content="{x:Static resx:Strings.PickArbitraryTargetButton}" Command="{Binding LinkEditor.BeginPickArbitraryTargetCommand}" />
                                <Button Content="{x:Static resx:Strings.CancelSelectionButton}" Command="{Binding LinkEditor.CancelPendingSelectionCommand}" />
                            </StackPanel>

                            <!-- 読み取り専用のジャンプ用一覧のため、しおり編集画面のTreeViewと異なり
                                 展開状態の保持は不要。全ノードを常に展開表示する。 -->
                            <TreeView Grid.Row="2" ItemsSource="{Binding LinkEditor.Bookmarks.Value}" Background="Transparent"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True" />
                                    </Style>
                                </TreeView.Styles>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate DataType="models:BookmarkNode" ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="2"
                                                   Tag="{Binding}" PointerReleased="OnLinkEditorBookmarkClick" />
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="{x:Static resx:Strings.LinkListHeader}" FontWeight="Bold" Margin="8" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding LinkEditor.LinkGroups.Value}" Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:LinkGroupInfo">
                                        <StackPanel Margin="4" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Converter={StaticResource LinkGroupDisplayConverter}}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Static resx:Strings.PreExistingLinkBadge}" FontSize="10" Foreground="Gray"
                                                           VerticalAlignment="Center" IsVisible="{Binding IsPreExisting}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Content="{x:Static resx:Strings.LinkJumpButton}" FontSize="11" Padding="6,2"
                                                        Tag="{Binding}" Click="OnLinkGroupJumpClick" />
                                                <Button Content="{x:Static resx:Strings.LinkEditButton}" FontSize="11" Padding="6,2"
                                                        Tag="{Binding}" Click="OnLinkGroupEditClick" IsVisible="{Binding !IsPreExisting}" />
                                                <Button Content="{x:Static resx:Strings.DeleteButton}" FontSize="11" Padding="6,2"
                                                        Tag="{Binding}" Click="OnLinkGroupDeleteClick" IsVisible="{Binding !IsPreExisting}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="{x:Static resx:Strings.SettingsButton}" Command="{Binding OpenSettingsCommand}" Margin="0,0,16,0" />
                <Button Content="{x:Static resx:Strings.BackToBookmarksButton}" Command="{Binding BackToBookmarksCommand}" Margin="0,0,8,0" />
                <Button Content="{x:Static resx:Strings.FinishLinkEditingButton}" Command="{Binding FinishLinkEditingCommand}" />
            </StackPanel>
        </Grid>

        <!-- 処理中オーバーレイ: IsBusy中は手順1・2/3の全コントロールを覆い、操作を防止する。 -->
        <Border Grid.Row="0" Background="#AA000000" IsVisible="{Binding IsBusy.Value}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Spacing="6">
                <TextBlock Text="{Binding StatusMessage.Value}" Foreground="White" FontSize="14"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <!--
                    5秒以上処理が続いた場合にのみ、コードビハインド(DispatcherTimer)がIsVisibleへ切り替える。
                    短時間で終わる処理では表示のチラつきを避けるため、既定はfalse。
                -->
                <TextBlock Name="BusyDetailText" Foreground="#DDDDDDDD" FontSize="12" IsVisible="False"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Text="{Binding BusyProgress.Value, Converter={StaticResource BusyProgressToTextConverter}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Padding="12,8" Background="#22808080">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage.Value}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Static resx:Strings.StatusBarProcessingLabel}" VerticalAlignment="Center"
                           IsVisible="{Binding IsBusy.Value}" />
            </Grid>
        </Border>
    </Grid>
</Window>
