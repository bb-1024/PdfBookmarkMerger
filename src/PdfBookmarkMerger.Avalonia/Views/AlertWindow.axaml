<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resx="clr-namespace:PdfBookmarkMerger.App.Resources;assembly=PdfBookmarkMerger.App"
        x:Class="PdfBookmarkMerger.AvaloniaApp.Views.AlertWindow"
        Icon="avares://PdfBookmarkMerger.Avalonia/Assets/app.ico"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <Button Content="{x:Static resx:Strings.OkButton}" HorizontalAlignment="Right" Click="OnOkClick" />
    </StackPanel>
</Window>
