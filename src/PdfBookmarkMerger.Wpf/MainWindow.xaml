<ui:FluentWindow x:Class="PdfBookmarkMerger.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:PdfBookmarkMerger.Core.Models;assembly=PdfBookmarkMerger.Core"
        xmlns:conv="clr-namespace:PdfBookmarkMerger.WpfApp.Converters"
        xmlns:vm="clr-namespace:PdfBookmarkMerger.App.ViewModels;assembly=PdfBookmarkMerger.App"
        xmlns:resx="clr-namespace:PdfBookmarkMerger.App.Resources;assembly=PdfBookmarkMerger.App"
        Title="{x:Static resx:Strings.AppTitle}" Height="760" Width="1300"
        Icon="pack://application:,,,/Assets/app.ico"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver">
    <ui:FluentWindow.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <conv:NullableDoubleToStringConverter x:Key="NullableDoubleToStringConverter" />
        <conv:ZoomPercentToStringConverter x:Key="ZoomPercentToStringConverter" />
        <conv:DepthToTitleWidthConverter x:Key="DepthToTitleWidthConverter" />
        <conv:PageNumberWidthConverter x:Key="PageNumberWidthConverter" />
        <conv:EditedHighlightBrushConverter x:Key="EditedHighlightBrushConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:BusyProgressToTextConverter x:Key="BusyProgressToTextConverter" />
        <conv:PageCountToTextConverter x:Key="PageCountToTextConverter" />
        <conv:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter" />
        <conv:PageIndicatorConverter x:Key="PageIndicatorConverter" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
        <conv:LinkGroupDisplayConverter x:Key="LinkGroupDisplayConverter" />
        <ObjectDataProvider x:Key="DestinationTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:BookmarkDestinationType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static resx:Strings.AppTitle}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 手順1: ファイル指定 -->
        <Grid Grid.Row="1" Margin="16"
              IsEnabled="{Binding IsBusy.Value, Converter={StaticResource InverseBooleanConverter}}"
              Visibility="{Binding Step.Value, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=SelectFiles}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,8" FontSize="14"
                       Text="{x:Static resx:Strings.SelectFilesInstruction}" TextWrapping="Wrap"/>

            <Border Grid.Row="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4">
                <ListBox x:Name="FileListBox"
                         ItemsSource="{Binding FileList.Files}"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AllowDrop="True"
                         Drop="OnFileListDrop"
                         DragOver="OnFileListDragOver"
                         PreviewMouseLeftButtonDown="OnFileListPreviewMouseLeftButtonDown"
                         PreviewMouseMove="OnFileListPreviewMouseMove"
                         SelectionChanged="OnFileListSelectionChanged"
                         SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PdfFileEntryViewModel}">
                            <!--
                                Foregroundを明示指定する。WPF-UIのListBoxItem標準スタイルは選択時に
                                Foregroundを白系(ListBoxItemSelectedForegroundThemeBrush)へ切り替えるが、
                                この行が使う選択時背景(SolidBackgroundFillColorSecondaryBrush)は薄い色のため、
                                指定しないと選択時に文字が読めなくなる。
                            -->
                            <Border Padding="6,5" CornerRadius="4" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <ui:SymbolIcon Symbol="DocumentPdf24" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{Binding PageCount.Value, Converter={StaticResource PageCountToTextConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Content="{x:Static resx:Strings.SettingsButton}" Command="{Binding OpenSettingsCommand}" Margin="0,0,24,0" />
                <ui:Button Content="{x:Static resx:Strings.AddFilesButton}" Command="{Binding AddFilesViaDialogCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{x:Static resx:Strings.AddFolderButton}" Command="{Binding AddFolderViaDialogCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{x:Static resx:Strings.DeleteButton}" Click="OnRemoveSelectedFileClick" Margin="0,0,8,0" />
                <ui:Button x:Name="MoveFileUpButton" Content="{x:Static resx:Strings.MoveUpButton}" Click="OnMoveFileUpClick" Margin="0,0,8,0" />
                <ui:Button x:Name="MoveFileDownButton" Content="{x:Static resx:Strings.MoveDownButton}" Click="OnMoveFileDownClick" Margin="0,0,24,0" />
                <ui:Button Content="{x:Static resx:Strings.NextButton}" Appearance="Primary" Command="{Binding ConfirmFilesCommand}" />
            </StackPanel>
        </Grid>

        <!-- 手順2・3: しおり編集 -->
        <Grid Grid.Row="1" Margin="16"
              IsEnabled="{Binding IsBusy.Value, Converter={StaticResource InverseBooleanConverter}}"
              Visibility="{Binding Step.Value, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=EditBookmarks}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,8" FontSize="14" TextWrapping="Wrap"><Run Text="{x:Static resx:Strings.EditBookmarksInstructionLine1}" /><LineBreak /><Run Text="{x:Static resx:Strings.EditBookmarksInstructionLine2}" /></TextBlock>

            <!-- ツリー開閉コントロール: 全ノードを閉じる/レベル指定で開閉/全ノードを開く -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <ui:Button Content="{x:Static resx:Strings.CollapseAllTreeButton}" Command="{Binding BookmarkTree.CollapseAllCommand}"
                           ToolTip="{x:Static resx:Strings.CollapseAllTreeButtonTooltip}" MinWidth="32" Margin="0,0,4,0" />
                <TextBlock Text="{x:Static resx:Strings.ExpandLevelLabel}" VerticalAlignment="Center" Margin="8,0,4,0" />
                <TextBox x:Name="ExpandLevelTextBox" Text="{Binding BookmarkTree.ExpandLevelInput.Value, Mode=TwoWay}"
                         ToolTip="{x:Static resx:Strings.ExpandLevelTextBoxTooltip}" Width="48"
                         LostFocus="OnExpandLevelTextBoxLostFocus" Margin="0,0,4,0" />
                <ui:Button Content="{x:Static resx:Strings.ExpandAllTreeButton}" Command="{Binding BookmarkTree.ExpandAllCommand}"
                           ToolTip="{x:Static resx:Strings.ExpandAllTreeButtonTooltip}" MinWidth="32" />
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4">
                <TreeView x:Name="BookmarkTreeView"
                          ItemsSource="{Binding BookmarkTree.RootNodes}"
                          Padding="0,0,0,32"
                          Background="Transparent"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          AllowDrop="True"
                          Drop="OnBookmarkTreeDrop"
                          DragOver="OnBookmarkTreeDragOver"
                          DragLeave="OnBookmarkTreeDragLeave"
                          PreviewMouseLeftButtonDown="OnBookmarkTreePreviewMouseLeftButtonDown"
                          PreviewMouseMove="OnBookmarkTreePreviewMouseMove"
                          SelectedItemChanged="OnBookmarkTreeSelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded.Value, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:BookmarkNodeViewModel}" ItemsSource="{Binding Children}">
                            <Border Padding="4,3" CornerRadius="4" Tag="{Binding}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsKeyboardFocusWithin}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding LevelNumber, Mode=OneTime, StringFormat=Lv.{0}}"
                                               Width="34" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                                    <TextBox Text="{Binding Title.Value, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="OnBookmarkTitleTextChanged" Margin="0,0,6,0">
                                        <TextBox.Width>
                                            <MultiBinding Converter="{StaticResource DepthToTitleWidthConverter}">
                                                <Binding Path="Depth" />
                                                <Binding Path="DataContext.BookmarkTree.TitleColumnBaseWidth.Value"
                                                         RelativeSource="{RelativeSource AncestorType=TreeView}" />
                                            </MultiBinding>
                                        </TextBox.Width>
                                    </TextBox>
                                    <ComboBox ItemsSource="{Binding Source={StaticResource DestinationTypeValues}}"
                                              SelectedItem="{Binding DestinationType.Value, Mode=TwoWay}" Width="90" Margin="0,0,6,0"
                                              IsEnabled="{Binding IsDestinationTypeEditable.Value}"
                                              Background="{DynamicResource ComboBoxDropDownBackground}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" Padding="4,3">
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox Content="{x:Static resx:Strings.ExpandCheckboxLabel}" IsChecked="{Binding IsOpen.Value, Mode=TwoWay}"
                                              IsEnabled="{Binding IsExpandToggleEditable.Value}"
                                              VerticalAlignment="Center" Width="90" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resx:Strings.LeftLabel}" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox Text="{Binding Left.Value, Converter={StaticResource NullableDoubleToStringConverter}}"
                                             IsEnabled="{Binding IsLeftEditable.Value}" Width="48" Margin="0,0,4,0" />
                                    <TextBlock Text="{x:Static resx:Strings.TopLabel}" VerticalAlignment="Center" Margin="0,0,2,0" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox Text="{Binding Top.Value, Converter={StaticResource NullableDoubleToStringConverter}}"
                                             IsEnabled="{Binding IsTopEditable.Value}" Width="48" Margin="0,0,4,0" />
                                    <TextBlock Text="{x:Static resx:Strings.ZoomLabel}" VerticalAlignment="Center" Margin="0,0,2,0" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox Text="{Binding Zoom.Value, Converter={StaticResource ZoomPercentToStringConverter}}"
                                             IsEnabled="{Binding IsZoomEditable.Value}" Width="48" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{x:Static resx:Strings.BookmarkOriginPrefixWithActionFormat}">
                                                <Binding Path="ActionType" Mode="OneTime" />
                                                <Binding Path="SourceFileName" Mode="OneTime" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBox Text="{Binding PreOffsetPageNumber.Value}"
                                             Width="{Binding PreOffsetPageNumber.Value, Converter={StaticResource PageNumberWidthConverter}}"
                                             Background="{Binding IsPageNumberEdited.Value, Converter={StaticResource EditedHighlightBrushConverter}}"
                                             Margin="0,0,4,0">
                                        <TextBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{x:Static resx:Strings.ResetPageNumberMenuItem}" Click="OnResetPreOffsetPageNumberClick" />
                                            </ContextMenu>
                                        </TextBox.ContextMenu>
                                    </TextBox>
                                    <TextBlock Text="{x:Static resx:Strings.BookmarkOriginSuffix}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,2,0" />
                                    <TextBlock Text="{Binding DisplayMergedPageNumber.Value}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <!-- 1段目: レベル上下・しおり追加(3種)・削除・レベル上限設定 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button x:Name="PromoteLevelButton" Content="{x:Static resx:Strings.PromoteLevelButton}" Click="OnPromoteLevelClick"
                               IsEnabled="False" Margin="0,0,8,0" />
                    <ui:Button x:Name="DemoteLevelButton" Content="{x:Static resx:Strings.DemoteLevelButton}" Click="OnDemoteLevelClick"
                               IsEnabled="False" Margin="0,0,24,0" />
                    <ui:Button Content="{x:Static resx:Strings.AddRootButton}" Click="OnAddRootBookmarkClick" Margin="0,0,8,0" />
                    <ui:Button Content="{x:Static resx:Strings.AddChildButton}" Click="OnAddChildBookmarkClick" Margin="0,0,8,0" />
                    <ui:Button Content="{x:Static resx:Strings.AddSiblingButton}" Click="OnAddSiblingBookmarkClick" Margin="0,0,8,0" />
                    <ui:Button Content="{x:Static resx:Strings.DeleteButton}" Click="OnDeleteBookmarkClick" Margin="0,0,24,0" />
                    <ui:Button x:Name="LevelCapButton" Content="{x:Static resx:Strings.SetLevelCapButton}" Click="OnSetLevelCapClick"
                               IsEnabled="False" />
                </StackPanel>
                <!-- 2段目: 設定・画面遷移・元に戻す・一律設定(2種)・結合実行 -->
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{x:Static resx:Strings.SettingsButton}" Command="{Binding OpenSettingsCommand}" Margin="0,0,24,0" />
                    <ui:Button Content="{x:Static resx:Strings.BackToFileListButton}" Command="{Binding BackToFileListCommand}" Margin="0,0,24,0" />
                    <ui:Button Content="{x:Static resx:Strings.UndoButton}" Command="{Binding BookmarkTree.UndoCommand}" Margin="0,0,24,0" />
                    <CheckBox Content="{x:Static resx:Strings.ForceFitCheckbox}" IsChecked="{Binding BookmarkTree.ForceFitForAll.Value, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,16,0" />
                    <CheckBox Content="{x:Static resx:Strings.GlobalExpandCheckbox}" IsThreeState="True"
                              IsChecked="{Binding BookmarkTree.GlobalExpandOverride.Value, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,24,0" />
                    <ui:Button Content="{x:Static resx:Strings.SaveBookmarkSettingsButton}" Appearance="Primary" Command="{Binding SaveBookmarkSettingsCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="{x:Static resx:Strings.MergeButton}" Appearance="Primary" Command="{Binding MergeCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 手順4: リンク編集 -->
        <Grid Grid.Row="1" Margin="16"
              IsEnabled="{Binding IsBusy.Value, Converter={StaticResource InverseBooleanConverter}}"
              Visibility="{Binding Step.Value, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=EditLinks}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,8" FontSize="14" TextWrapping="Wrap"
                       Text="{x:Static resx:Strings.EditLinksInstructionLine1}" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <ui:Button Content="{x:Static resx:Strings.PreviousPageButton}" Command="{Binding LinkEditor.PreviousPageCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{x:Static resx:Strings.NextPageButton}" Command="{Binding LinkEditor.NextPageCommand}" Margin="0,0,16,0" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource PageIndicatorConverter}">
                            <Binding Path="LinkEditor.CurrentPageIndex.Value" />
                            <Binding Path="LinkEditor.PageCount.Value" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <ui:Button Content="{x:Static resx:Strings.ZoomOutButton}" Command="{Binding LinkEditor.ZoomOutCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{x:Static resx:Strings.ZoomInButton}" Command="{Binding LinkEditor.ZoomInCommand}" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
                        <Grid>
                            <Image x:Name="PdfPreviewImage"
                                   Source="{Binding LinkEditor.PageImage.Value, Converter={StaticResource ByteArrayToImageConverter}}"
                                   Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   MouseLeftButtonDown="OnPdfPreviewMouseLeftButtonDown"
                                   MouseMove="OnPdfPreviewMouseMove"
                                   MouseLeftButtonUp="OnPdfPreviewMouseLeftButtonUp" />
                            <Canvas x:Name="LinkOverlayCanvas" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{x:Static resx:Strings.LinkEditorBookmarksHeader}" FontWeight="Bold" Margin="8" />

                            <!-- 文字選択が確定し、ジャンプ先の指定待ちの間だけ表示する。 -->
                            <StackPanel Grid.Row="1" Margin="8,0,8,8"
                                        Visibility="{Binding LinkEditor.PendingSelection.Value, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <TextBlock Text="{x:Static resx:Strings.LinkDestinationPickerHeader}" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock Text="{x:Static resx:Strings.PickArbitraryTargetHint}" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding LinkEditor.IsPickingArbitraryTarget.Value, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}" />
                                <ui:Button Content="{x:Static resx:Strings.PickArbitraryTargetButton}" Command="{Binding LinkEditor.BeginPickArbitraryTargetCommand}" Margin="0,4,0,4" />
                                <ui:Button Content="{x:Static resx:Strings.CancelSelectionButton}" Command="{Binding LinkEditor.CancelPendingSelectionCommand}" />
                            </StackPanel>

                            <ListBox Grid.Row="2" ItemsSource="{Binding LinkEditor.Bookmarks.Value}" Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:BookmarkNode}">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="4"
                                                   Tag="{Binding}" MouseLeftButtonUp="OnLinkEditorBookmarkClick" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{x:Static resx:Strings.LinkListHeader}" FontWeight="Bold" Margin="8" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding LinkEditor.LinkGroups.Value}" Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LinkGroupInfo}">
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Converter={StaticResource LinkGroupDisplayConverter}}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Content="{x:Static resx:Strings.LinkJumpButton}" FontSize="11" Padding="6,2" Margin="0,0,4,0"
                                                           Click="OnLinkGroupJumpClick" Tag="{Binding}" />
                                                <ui:Button Content="{x:Static resx:Strings.LinkEditButton}" FontSize="11" Padding="6,2" Margin="0,0,4,0"
                                                           Click="OnLinkGroupEditClick" Tag="{Binding}" />
                                                <ui:Button Content="{x:Static resx:Strings.DeleteButton}" FontSize="11" Padding="6,2"
                                                           Click="OnLinkGroupDeleteClick" Tag="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Content="{x:Static resx:Strings.BackToBookmarksButton}" Command="{Binding BackToBookmarksCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{x:Static resx:Strings.FinishLinkEditingButton}" Appearance="Primary" Command="{Binding FinishLinkEditingCommand}" />
            </StackPanel>
        </Grid>

        <!-- 処理中オーバーレイ: IsBusy中は手順1・2/3の全コントロールを覆い、操作を防止する。 -->
        <Border Grid.Row="1" Background="#AA000000"
                Visibility="{Binding IsBusy.Value, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage.Value}" Foreground="White" FontSize="14"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                <!--
                    5秒以上処理が続いた場合にのみ、コードビハインド(DispatcherTimer)がVisibleへ切り替える。
                    短時間で終わる処理では表示のチラつきを避けるため、既定はCollapsed。
                -->
                <TextBlock x:Name="BusyDetailText" Foreground="#DDDDDDDD" FontSize="12" Visibility="Collapsed"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="{Binding BusyProgress.Value, Converter={StaticResource BusyProgressToTextConverter}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="12,8" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage.Value}" VerticalAlignment="Center" />
                <ui:ProgressRing Grid.Column="1" IsIndeterminate="True" Width="18" Height="18"
                                  Visibility="{Binding IsBusy.Value, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
