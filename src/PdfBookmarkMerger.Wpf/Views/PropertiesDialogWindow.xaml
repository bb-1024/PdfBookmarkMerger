<ui:FluentWindow x:Class="PdfBookmarkMerger.WpfApp.Views.PropertiesDialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="PDFプロパティ"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="440" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid Margin="16,40,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="PDFプロパティ" Margin="-16,-40,-16,8" VerticalAlignment="Top">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="タイトル" Margin="0,0,0,4" />
            <ui:TextBox Text="{Binding Title.Value, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="作成者" Margin="0,0,0,4" />
            <ui:TextBox Text="{Binding Author.Value, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="件名" Margin="0,0,0,4" />
            <ui:TextBox Text="{Binding Subject.Value, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="キーワード" Margin="0,0,0,4" />
            <ui:TextBox Text="{Binding Keywords.Value, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,12">
            <TextBlock Text="アプリケーション" Margin="0,0,0,4" />
            <ui:TextBox Text="{Binding Creator.Value, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="キャンセル" Click="OnCancelClick" Margin="0,0,8,0" />
            <ui:Button x:Name="OkButton" Content="OK" Appearance="Primary" IsDefault="True" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
