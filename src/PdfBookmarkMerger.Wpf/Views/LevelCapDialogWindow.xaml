<ui:FluentWindow x:Class="PdfBookmarkMerger.WpfApp.Views.LevelCapDialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:resx="clr-namespace:PdfBookmarkMerger.App.Resources;assembly=PdfBookmarkMerger.App"
                 Title="{x:Static resx:Strings.LevelCapDialogTitle}"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="400" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid Margin="16,40,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static resx:Strings.LevelCapDialogTitle}" Margin="-16,-40,-16,8" VerticalAlignment="Top">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="{x:Static resx:Strings.LevelCapDescription}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="{x:Static resx:Strings.LevelCapLabel}" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding AvailableLevels}"
                      SelectedItem="{Binding SelectedLevel.Value, Mode=TwoWay}"
                      Background="{DynamicResource ComboBoxDropDownBackground}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" Padding="4,3">
                            <TextBlock Text="{Binding StringFormat=Lv.{0}}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="{x:Static resx:Strings.CancelButton}" Click="OnCancelClick" Margin="0,0,8,0" />
            <ui:Button Content="{x:Static resx:Strings.OkButton}" Appearance="Primary" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
